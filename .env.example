# ------------------------------------------------------------------
# Facilita - Exemplos de configuração de ambiente (.env)
# Copie este arquivo para .env e preencha conforme seu ambiente.
# ATENÇÃO: Nunca envie o arquivo .env com credenciais reais para o Git!
# ------------------------------------------------------------------

# 1. Banco de Dados (Supabase PostgreSQL para Produção / Nuvem)
# Obtenha no painel do Supabase > Project Settings > Database > Connection string (URI)
# Use preferencialmente o Transaction Pooler (porta 6543) ou Session (porta 5432)
# Exemplo Supabase:
# DATABASE_URL=postgresql://postgres.[SEU_PROJETO]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Pool de conexões PostgreSQL (número máximo de conexões simultâneas)
# PG_MAX_CONNECTIONS=8

# 2. Segurança e Sessão
# Chave criptográfica para proteção dos cookies de sessão. Em produção gere uma chave forte.
# SECRET_KEY=gere-uma-chave-aleatoria-longa-e-segura

# 3. HTTPS e Proxy Reverso (Ativar em Produção / Vercel)
# EMPRESTIMO_HTTPS=1
# EMPRESTIMO_BEHIND_PROXY=1

# 4. Domínios permitidos (separados por vírgula)
# EMPRESTIMO_TRUSTED_HOSTS=facilitando.vercel.app,facilita-br.vercel.app,127.0.0.1,localhost

# 5. Desenvolvimento Local (SQLite)
# Se DATABASE_URL não for informada, o sistema usa SQLite automaticamente.
# EMPRESTIMO_DATA_DIR=data
# EMPRESTIMO_DATABASE=data/emprestimos.db

# 6. Servidor local de desenvolvimento (python app.py)
# EMPRESTIMO_HOST=127.0.0.1
# EMPRESTIMO_PORT=5000
# EMPRESTIMO_DEBUG=1

# 7. Serviço de E-mail Transacional (SMTP para Recuperação de Senhas)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-aplicativo
# SMTP_USE_TLS=1
# SMTP_FROM=Facilita <seu-email@gmail.com>

# 8. Contato do Administrador / Suporte (Link de WhatsApp na recuperação de senha)
# WHATSAPP_SUPORTE=85999998888

